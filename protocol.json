  "target_representation": {
    "level_variable": "EV_Total (vehicle count)",
    "learning_target": "r_t = log(y_t) - log(y_{t-1})",
    "scaling": "z_t = (r_t - mu_{r,train}) / std_{r,train} (fitted per fold)",
    "inversion_formula": "y_{T+h} = y_T * exp( sum_{j=1}^h r_{T+j} )",
    "clipping": "None (negative growth rates are preserved)"
  },
  "features": {
    "names": [
      "r_lag1",
      "r_lag2",
      "r_lag3",
      "r_roll3",
      "r_roll6"
    ],
    "count": 5,
    "shift_applied": "shift(1) enforced on all lag and rolling features to prevent leakage",
    "warmup_months": 7
  },
  "validation_protocol": {
    "method": "Expanding-window time series cross-validation (3 folds)",
    "folds": [
      {
        "fold": 1,
        "origin": "2020-11",
        "train_end": "2020-11-30",
